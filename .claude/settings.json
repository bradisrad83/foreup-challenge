{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.backup)",
      "Read(./.env.production)",
      "Read(./database/*.sqlite)",
      "Read(./database/*.sqlite-*)",
      "Read(./vendor/**)",
      "Read(./node_modules/**)",
      "Read(./public/build/**)"
    ]
  }
}
